# 在启动 AI 服务前，将用到的配置注入进程环境。服务不会自动加载 .env。
# 默认用离线模板。启用本地 Ollama 时填已安装的模型名。
AI_MVP_OLLAMA_MODEL=

# 需要 DeepSeek 时设置为 1，并在运行环境中注入实际 Key。
AI_MVP_REMOTE_ENABLED=0
DEEPSEEK_API_KEY=

# 连接前端或中台的币价入口，以及中台的只读账户接口。
AI_MVP_MARKET_URL=
AI_MVP_TRADING_URL=
# AI_MVP_MARKET_TOKEN=
# AI_MVP_TRADING_TOKEN=

# 对外监听或连接中台时配置 AI 服务的 Bearer 凭证。
AI_MVP_API_TOKEN=
